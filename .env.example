WMS_MONGO_USER=your_db_user
WMS_MONGO_PASS=your_db_password
WMS_MONGO_HOST=yourcluster.xxxxx.mongodb.net
WMS_MONGO_OPTIONS=retryWrites=true&w=majority&appName=WarehouseManager
WMS_DB=wms
WMS_USER=admin
WMS_PASS=change_me
# Or give one full string instead (overrides the four WMS_MONGO_* lines above):
# WMS_MONGO_URI=mongodb+srv://user:pass@host/?retryWrites=true&w=majority
